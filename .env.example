# Orbit reads these environment variables at runtime (optional overrides).
# The API key may also be stored in the app settings file (see README).

# OpenAI-compatible API key (DeepSeek by default)
ORBIT_API_KEY=

# Override the model endpoint base URL (no trailing /v1 unless your provider needs it)
# DeepSeek default: https://api.deepseek.com
ORBIT_BASE_URL=https://api.deepseek.com

# Model name to use for the agent
ORBIT_MODEL=deepseek-chat

# Sampling temperature (0.0 - 2.0)
ORBIT_TEMPERATURE=0.2
